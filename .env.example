# ================================================================
# COVEN — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ================================================================

# ── SUPABASE ─────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── CLOUDINARY ────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# Create an unsigned upload preset named "coven_artworks" in
# Cloudinary Dashboard → Settings → Upload → Upload presets
VITE_CLOUDINARY_UPLOAD_PRESET=coven_artworks

# ── TORN API (optional — server-side payment verification) ────
# These are read-only public API keys for on-chain tx lookups.
# Do NOT use a full-access key here.
VITE_TORN_API_KEY_PRIMARY=your-torn-api-key
